# Settings for compose.yaml (deploy/push.sh writes .env from S40_* variables).
# No secrets here: the Claude API key goes to secrets/anthropic_api_key
# (deploy/set-key.sh), the admin token is generated on the server.
ENVIRONMENT=production
CLAUDE_MODEL=claude-opus-5
CLAUDE_EFFORT=low
CLAUDE_FALLBACKS=default
MOCK_ANTHROPIC=1
DAILY_REQUEST_LIMIT=100
DAILY_OUTPUT_TOKEN_LIMIT=100000
